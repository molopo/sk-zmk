#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        lock {
            bindings = <&to 4>;
            key-positions = <20 22 24>;
        };

        bt {
            bindings = <&lt 3 A>;
            key-positions = <30 31 32>;
        };

        unlock {
            bindings = <&to 0>;
            key-positions = <20 21 22 23>;
        };
    };

    macros {
        altsae: altsae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RA(LG(S)) &kp RA(LG(A)) &kp RA(LG(E))>;
            label = "ALTSAE";
        };

        mmattest: mmattest {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp F2 &kp BACKSPACE &kp PERIOD &kp M &kp M &kp A &kp T &kp T &kp E &kp S &kp T>,
                <&macro_wait_time 52>,
                <&kp ENTER &kp F2>;

            label = "MMATTEST";
        };

        dot25: dot25 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT &kp N2 &kp N5>;
            label = "DOT25";
        };

        dot35: dot35 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT &kp N3 &kp N5>;
            label = "DOT35";
        };

        dot50: dot50 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOT &kp N5 &kp N0>;
            label = "DOT50";
        };

        dcl30: dcl30 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp DOT &kp D &kp C &kp L &kp N3 &kp N0>;
            label = "DCL30";
        };

        dcm30: dcm30 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp DOT &kp D &kp C &kp M &kp N3 &kp N0>;
            label = "DCM30";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q        &kp W        &kp E           &kp R           &kp T      &kp Y        &kp U            &kp I                &kp O             &kp P
&kp A        &kp S        &kp D           &kp F           &kp G      &kp H        &kp J            &kp K                &kp L             &kp SEMI
&mt LSHFT Z  &mt LCTRL X  &mt LEFT_ALT C  &mt LEFT_GUI V  &kp B      &kp N        &mt RIGHT_GUI M  &mt RIGHT_ALT COMMA  &mt RCTRL PERIOD  &mt RSHFT FSLH
                          &kp TAB         &kp RET         &lt 0 TAB  &lt 1 ENTER  &kp BSPC         &kp SPACE
            >;
        };

        mod {
            bindings = <
&kp F1          &kp F2              &kp F3             &kp F4          &kp F5   &kp MINUS  &kp N7             &kp N8             &kp N9              &kp BACKSPACE
&kp F6          &kp F7              &kp F8             &kp F9          &kp F10  &kp SEMI   &kp N4             &kp N5             &kp N6              &kp DOT
&mt LSHFT LEFT  &mt LCTRL UP_ARROW  &mt LEFT_ALT DOWN  &mt LGUI RIGHT  &dot25   &kp N0     &mt RGUI NUMBER_1  &mt RALT NUMBER_2  &mt RCTRL NUMBER_3  &mt RIGHT_SHIFT FSLH
                                    &mmattest          &dot35          &altsae  &altsae    &dcl30             &dcm30
            >;
        };

        modalso {
            bindings = <
&kp F1          &kp F2              &kp F3             &kp F4          &kp F5   &kp MINUS  &kp N7             &kp N8             &kp N9              &kp BACKSPACE
&kp F6          &kp F7              &kp F8             &kp F9          &kp F10  &kp SEMI   &kp N4             &kp N5             &kp N6              &kp DOT
&mt LSHFT LEFT  &mt LCTRL UP_ARROW  &mt LEFT_ALT DOWN  &mt LGUI RIGHT  &dot25   &kp N0     &mt RGUI NUMBER_1  &mt RALT NUMBER_2  &mt RCTRL NUMBER_3  &mt RIGHT_SHIFT FSLH
                                    &mmattest          &dot35          &altsae  &altsae    &dcl30             &dcm30
            >;
        };

        bt {
            bindings = <
&out OUT_BLE  &bt BT_CLR  &none  &sys_reset  &bootloader  &bootloader  &sys_reset  &none  &none  &none
&none         &none       &none  &none       &none        &none        &none       &none  &none  &none
&none         &none       &none  &none       &none        &none        &none       &none  &none  &none
                          &none  &none       &none        &none        &none       &none
            >;
        };

        lock {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none
              &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
